     "@id": "https://identifiers.org/hgnc:8574",
     "identifier": "HGNC:8574",
     "url": "https://www.genenames.org/data/gene-symbol-report/#!/hgnc_id/HGNC:8574",
     "description": "platelet activating factor acetylhydrolase 1b regulatory subunit 1",
