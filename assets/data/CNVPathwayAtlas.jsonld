    {
     "@type": "MedicalCondition",
     "@id": "http://www.orpha.net/ORDO/Orphanet_96069",
     "identifier": "ORPHA:96069",
     "url": "https://www.orpha.net/en/disease/detail/96069",
     "code": {
      "@type": "MedicalCode",
      "codeValue": "96069",
      "codingSystem": "ORPHA"
     },
     "name": "Distal duplication 1p36 syndrome",
     "description": "Distal trisomy 1p36 is a rare chromosomal anomaly syndrome, resulting from the partial duplication of the short arm of chromosome 1, characterized by borderline to mild intellectual disability, mild developmental delay, metopic craniosynostosis and mild craniofacial dysmorphism (incl. slopping forehead, bitemporal narrowing, blepharophimosis). Other associated abnormalities may include growth retardation, microcephaly, large hands, syndactyly, supernumerary ribs, rectal stenosis and/or anterior displacement of anus. Congenital heart malformations (e.g. atrial septal defect, patent ductus arteriosus) have also been reported.",
     "additionalProperty": [
      {
       "@type": "PropertyValue",
       "name": "CNV cause",
       "value": "distal duplication"
      },
      {
       "@type": "PropertyValue",
       "name": "Orphanet prevalence class",
       "value": "Unknown"
      }
     ]
    }
   ],
