   "description": "A microdeletion in this region, affecting CREBBP gene, causes Rubinstein-Taybi syndrome. Duplications of CREBBP in this region have also been reported.",
   "hasBioChemEntityPart": [
    {
     "@type": "Gene",
     "dct:conformsTo": {
      "@id": "https://bioschemas.org/profiles/Gene/1.0-RELEASE"
     },
     "name": "CREBBP",
     "@id": "https://identifiers.org/hgnc:2348",
     "identifier": "HGNC:2348",
     "url": "https://www.genenames.org/data/gene-symbol-report/#!/hgnc_id/HGNC:2348",
     "description": "CREB binding lysine acetyltransferase ",
     "sameAs": [
      "https://identifiers.org/ncbigene:1387",
      "https://identifiers.org/ensembl:ENSG00000005339",
      "https://identifiers.org/uniprot:Q92793",
