    {
     "@type": "MedicalCondition",
     "@id": "http://www.orpha.net/ORDO/Orphanet_904",
     "identifier": "ORPHA:904",
     "url": "https://www.orpha.net/en/disease/detail/904",
     "code": {
      "@type": "MedicalCode",
      "codeValue": "904",
      "codingSystem": "ORPHA"
     },
     "name": "Williams syndrome",
     "description": "A rare genetic multisystemic neurodevelopmental disorder characterized by a distinct facial appearance, cardiac anomalies (most frequently supravalvular aortic stenosis), cognitive and developmental abnormalities, and connective tissue abnormalities (e.g., joint laxity). Facial dysmorphism is characterized by a broad forehead, bitemporal narrowing, periorbital fullness, stellate and/or lacy iris pattern, short upturned nose with bulbous tip, long philtrum, wide mouth, full lips and mild micrognathia.",
     "sameAs": [
      "https://identifiers.org/mim:194050"
     ],
     "additionalProperty": [
      {
       "@type": "PropertyValue",
       "name": "CNV cause",
       "value": "deletion"
      },
      {
       "@type": "PropertyValue",
       "name": "Orphanet prevalence class",
       "value": "Unknown"
      }
     ],
     "signOrSymptom": [
      {
       "@type": "MedicalSignOrSymptom",
