    {
     "@type": "MedicalCondition",
     "@id": "http://www.orpha.net/ORDO/Orphanet_228415",
     "identifier": "ORPHA:228415",
     "url": "https://www.orpha.net/en/disease/detail/228415",
     "code": {
      "@type": "MedicalCode",
      "codeValue": "228415",
      "codingSystem": "ORPHA"
     },
     "name": "5q35 microduplication syndrome",
     "description": "A rare partial duplication of the long arm of chromosome 5 characterized by low birth weight, developmental delay, intellectual disability, microcephaly, short stature, and behavioral problems. Variable digital, urogenital, cardiac and gastrointestinal anomalies can sometimes occur, as well as variable unremarkable facial dysmorphism. Other signs migh include vision/eye anomalies and delayed bone age.",
     "additionalProperty": [
      {
       "@type": "PropertyValue",
       "name": "CNV cause",
       "value": "microduplication"
      },
      {
       "@type": "PropertyValue",
       "name": "Orphanet prevalence class",
       "value": "<1 / 1 000 000"
      }
     ],
     "signOrSymptom": [
      {
       "@type": "MedicalSignOrSymptom",
