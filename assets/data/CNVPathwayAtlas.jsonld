    {
     "@type": "MedicalCondition",
     "@id": "http://www.orpha.net/ORDO/Orphanet_261337",
     "identifier": "ORPHA:261337",
     "url": "https://www.orpha.net/en/disease/detail/261337",
     "code": {
      "@type": "MedicalCode",
      "codeValue": "261337",
      "codingSystem": "ORPHA"
     },
     "name": "Distal 22q11.2 microduplication syndrome",
     "description": "A rare chromosomal anomaly syndrome, resulting from the partial duplication of the long arm of chromosome 22, with a highly variable phenotype principally characterized by developmental delay, intellectual disability, behavioral anomalies, and non-specific craniofacial dysmorphism. Congenital heart malformations, visual and hearing impairment, urogenital abnormalities, and seizures have also been reported. Penetrance is incomplete. In 70% of cases, the duplication is inherited from as asymptomatic parent.",
     "additionalProperty": [
      {
       "@type": "PropertyValue",
       "name": "CNV cause",
       "value": "microduplication"
      },
      {
       "@type": "PropertyValue",
       "name": "Orphanet prevalence class",
       "value": "Unknown"
      }
     ],
