   ],
   "associatedDisease": [
    {
     "@type": "MedicalCondition",
     "@id": "http://www.orpha.net/ORDO/Orphanet_96078",
     "identifier": "ORPHA:96078",
     "url": "https://www.orpha.net/en/disease/detail/96078",
     "code": {
      "@type": "MedicalCode",
      "codeValue": "96078",
      "codingSystem": "ORPHA"
     },
     "name": "16p13.3 microduplication syndrome",
     "description": "16p13.3 microduplication syndrome is a rare chromosomal anomaly syndrome resulting from a partial duplication of the short arm of chromosome 16 and manifesting with a variable phenotype which is mostly characterized by: mild to moderate intellectual deficit and developmental delay (particularly speech), normal growth, short, proximally implanted thumbs and other hand and feet malformations (such as camptodactyly, syndactyly, club feet), mild arthrogryposis and characteristic facies (upslanting, narrow palpebral fissures, hypertelorism, mid face hypoplasia, bulbous nasal tip and low set ears). Other reported manifestations include cryptorchidism, inguinal hernia and behavioral problems.",
     "sameAs": [
      "https://identifiers.org/mim:613458"
     ],
     "additionalProperty": [
      {
       "@type": "PropertyValue",
       "name": "CNV cause",
       "value": "microduplication"
      },
      {
       "@type": "PropertyValue",
       "name": "Orphanet prevalence class",
       "value": "<1 / 1 000 000"
      }
     ]
    },
    {
     "@type": "MedicalCondition",
     "@id": "http://www.orpha.net/ORDO/Orphanet_353281",
