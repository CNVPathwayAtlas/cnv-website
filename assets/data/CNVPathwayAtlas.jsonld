     "@type": "MedicalCondition",
     "@id": "http://www.orpha.net/ORDO/Orphanet_261183",
     "identifier": "ORPHA:261183",
     "url": "https://www.orpha.net/en/disease/detail/261183",
     "code": {
      "@type": "MedicalCode",
      "codeValue": "261183",
      "codingSystem": "ORPHA"
     },
     "name": "15q11.2 microdeletion syndrome",
     "description": "15q11.2 microdeletion syndrome is a rare partial autosomal monosomy with a variable phenotypic expression and reduced penetrance associated with an increased susceptibility to neuropsychiatric or neurodevelopmental disorders including delayed psychomotor development, speech delay, autism spectrum disorder, attention deficit-hyperactivity disorder, obsessive-compulsive disorder, epilepsy or seizures. It may also include mild non-specific dysmorphic features (such as dysplastic ears, broad forehead, hypertelorism), cleft palate, neurological and neuroimaging abnormalities (such as ataxia and muscular hypotonia).",
     "sameAs": [
      "https://identifiers.org/mim:615656"
     ],
     "additionalProperty": [
      {
       "@type": "PropertyValue",
       "name": "CNV cause",
       "value": "microdeletion"
      },
      {
       "@type": "PropertyValue",
       "name": "Orphanet prevalence class",
       "value": "<1 / 1 000 000"
      }
     ],
